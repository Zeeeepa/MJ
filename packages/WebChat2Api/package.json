  "description": "Convert Web UIs to OpenAI-Compatible Inference Endpoints with multi-strategy browser automation",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
