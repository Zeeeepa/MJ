    "@types/uuid": "^9.0.6",
    "@types/ws": "^8.5.8",
    "@types/bcrypt": "^5.0.2",
    "typescript": "^5.4.5",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.5"
