  "description": "Convert any web chat UI into OpenAI-compatible API endpoints with multi-provider support and parallel execution",
  "main": "dist/server-enhanced.js",
  "types": "dist/server-enhanced.d.ts",
  "scripts": {
    "start": "node dist/server-enhanced.js",
    "start:basic": "node dist/server.js",
    "dev": "ts-node src/server-enhanced.ts",
    "dev:basic": "ts-node src/server.ts",
    "build": "tsc",
    "test": "jest",
    "migrate": "sqlcmd -i migrations/001_create_webchat_tables.sql"
  },
  "keywords": [
    "webchat",
    "openai",
    "api",
    "gateway",
    "automation",
    "multi-provider",
    "parallel",
    "load-balancing"
  ],
