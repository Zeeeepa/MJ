{
  "name": "@memberjunction/webchat2api",
  "version": "2.0.0",
  "description": "Convert any web chat UI into OpenAI-compatible API endpoints with multi-provider support and parallel execution",
  "main": "dist/production-server.js",
  "types": "dist/production-server.d.ts",
  "scripts": {
    "start": "node dist/production-server.js",
    "start:legacy": "node dist/real-working-server.js",
    "start:simple": "node dist/simple-server.js",
    "dev": "ts-node src/production-server.ts",
    "dev:legacy": "ts-node src/real-working-server.ts",
    "build": "tsc --skipLibCheck",
    "test:complete": "ts-node test-complete.ts",
    "test": "jest",
    "migrate": "sqlcmd -i migrations/001_create_webchat_tables.sql",
    "demo:ai": "ts-node src/examples/ai-native-demo.ts",
    "demo:ai:conversation": "ts-node src/examples/ai-native-demo.ts conversation",
    "demo:ai:streaming": "ts-node src/examples/ai-native-demo.ts streaming",
    "demo:multi-strategy": "ts-node src/examples/multi-strategy-demo.ts",
    "demo:element-identification": "ts-node src/examples/multi-strategy-demo.ts element-identification",
    "demo:flow-recording": "ts-node src/examples/multi-strategy-demo.ts flow-recording",
    "demo:strategy-fallback": "ts-node src/examples/multi-strategy-demo.ts strategy-fallback"
  },
  "keywords": [
    "webchat",
    "openai",
    "api",
    "gateway",
    "automation",
    "multi-provider",
    "parallel",
    "load-balancing"
  ],
  "author": "MemberJunction",
  "license": "MIT",
  "dependencies": {
    "@adaas/a-server": "^0.0.22",
    "@centralinc/browseragent": "^1.9.5",
    "@just-every/crawl": "^1.0.8",
    "@memberjunction/actions": "^2.125.0",
    "@memberjunction/ai": "^2.125.0",
    "@memberjunction/ai-anthropic": "^2.125.0",
    "@memberjunction/ai-gemini": "^2.125.0",
    "@memberjunction/ai-openai": "^2.125.0",
    "@memberjunction/communication-engine": "^2.125.0",
    "@memberjunction/core": "^2.125.0",
    "@memberjunction/metadata-sync": "^2.125.0",
    "@memberjunction/queue": "^2.125.0",
    "@memberjunction/react-test-harness": "^2.125.0",
    "@memberjunction/server": "^2.125.0",
    "@memberjunction/sqlserver-dataprovider": "^2.125.0",
    "@memberjunction/storage": "^2.125.0",
    "@olib-ai/owl-browser-sdk": "^1.2.3",
    "@skrillex1224/playwright-toolkit": "^2.0.50",
    "agentic-qe": "^2.7.4",
    "axios": "^1.6.0",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "mj_generatedentities": "^1.0.0",
    "playwright": "^1.57.0",
    "qa-agent": "^2.3.1",
    "qastell": "^0.6.1",
    "uuid": "^9.0.1",
    "valifetch": "^0.2.0",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.15",
    "@types/express": "^4.17.20",
    "@types/jest": "^29.5.5",
    "@types/node": "^20.8.0",
    "@types/uuid": "^9.0.6",
    "@types/ws": "^8.5.8",
    "jest": "^29.7.0",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
