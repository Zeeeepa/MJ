# Server Configuration
PORT=3000
NODE_ENV=development

# Vision AI Configuration (GLM-4.6V or other OpenAI-compatible vision models)
VISION_AI_API_KEY=your-api-key-here
VISION_AI_BASE_URL=https://api.z.ai/v1
VISION_AI_MODEL=glm-4.6v

# Alternative: Use Claude Vision
# VISION_AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=your-anthropic-key

# Alternative: Use OpenAI GPT-4 Vision
# VISION_AI_PROVIDER=openai
# OPENAI_API_KEY=your-openai-key

# Storage Configuration
DATA_DIR=./data
SCREENSHOTS_DIR=./data/screenshots
COOKIES_DIR=./data/cookies
FLOWS_DIR=./data/flows

# Security
ENCRYPTION_KEY=your-32-character-encryption-key-here

# Logging
LOG_LEVEL=info

