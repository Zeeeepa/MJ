{
  "name": "@memberjunction/web2api",
  "version": "2.125.0",
  "description": "Convert any web chat interface into an OpenAI-compatible API endpoint using MemberJunction framework",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/server/index.ts",
    "dev:enhanced": "tsx watch src/server/enhanced-server.ts",
    "start": "node dist/server/index.js",
    "start:enhanced": "node dist/server/enhanced-server.js",
    "start:dev": "npm run dev",
    "start:enhanced:dev": "npm run dev:enhanced",
    "test": "jest",
    "lint": "eslint src --ext .ts",
    "clean": "rm -rf dist",
    "register-services": "tsx src/scripts/register-services.ts",
    "test-services": "tsx src/scripts/test-all-services.ts",
    "test:real-auth": "tsx src/scripts/test-real-authentication.ts"
  },
  "dependencies": {
    "@memberjunction/ai": "^2.125.0",
    "@memberjunction/ai-anthropic": "^2.125.0",
    "@memberjunction/ai-openai": "^2.125.0",
    "@memberjunction/ai-gemini": "^2.125.0",
    "@memberjunction/core": "^2.125.0",
    "@memberjunction/server": "^2.125.0",
    "@memberjunction/queue": "^2.125.0",
    "@memberjunction/storage": "^2.125.0",
    "@memberjunction/sqlserver-dataprovider": "^2.125.0",
    "@memberjunction/communication-engine": "^2.125.0",
    "@memberjunction/actions": "^2.125.0",
    "@memberjunction/metadata-sync": "^2.125.0",
    "@olib-ai/owl-browser-sdk": "^1.2.3",
    "@skrillex1224/playwright-toolkit": "^2.0.50",
    "@centralinc/browseragent": "^1.9.5",
    "jshook-reverse-tool": "^0.1.1",
    "playwright": "^1.57.0",
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "axios": "^1.6.0",
    "ws": "^8.14.2",
    "uuid": "^9.0.1",
    "bcrypt": "^5.1.1",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/bcrypt": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/ws": "^8.5.10",
    "typescript": "^5.3.0",
    "tsx": "^4.7.0",
    "eslint": "^8.56.0",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.11"
  },
  "keywords": [
    "web2api",
    "openai",
    "chat",
    "automation",
    "browser",
    "ai",
    "memberjunction"
  ],
  "author": "MemberJunction",
  "license": "MIT"
}
